package SELLER;

import java.util.*;

class Product {
    private String id;
    private String name;
    private int quantity;
    private double price;

    Product(String id, String name, int quantity, double price) {
        this.id = id;
        this.name = name;
        this.quantity = quantity;
        this.price = price;
    }

    public String getId() { return id; }
    public String getName() { return name; }
    public int getQuantity() { return quantity; }
    public double getPrice() { return price; }

    public void updateQuantity(int qtySold) {
        if (quantity >= qtySold) quantity -= qtySold;
        else System.out.println("Not enough stock for " + name);
    }

    public double sell(int qty) {
        if (qty <= quantity) {
            updateQuantity(qty);
            return qty * price;
        } else {
            System.out.println("Insufficient stock for " + name);
            return 0;
        }
    }

    public void display() {
        System.out.println(id + " | " + name + " | Qty: " + quantity + " | Price: " + price);
    }
}

class Dashboard {
    private ArrayList<Product> products = new ArrayList<>();
    private double totalSales = 0;

    public void addProduct(Product p) {
        products.add(p);
        System.out.println("Product added: " + p.getName());
    }

    public void viewProducts() {
        System.out.println("\n--- Product List ---");
        for (Product p : products) {
            p.display();
        }
    }

    public void sellProduct(String id, int qty) {
        for (Product p : products) {
            if (p.getId().equals(id)) {
                double sale = p.sell(qty);
                totalSales += sale;
                if (sale > 0) System.out.println("Sold " + qty + " of " + p.getName());
                return;
            }
        }
        System.out.println("Product not found.");
    }

    public void viewSalesReport() {
        System.out.println("\nTotal Sales Revenue: Rs." + totalSales);
    }
}

public class SimpleSellerDashboard {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Dashboard dash = new Dashboard();
        int choice;

        do {
            System.out.println("\n=== SIMPLE SELLER DASHBOARD ===");
            System.out.println("1. Add Product");
            System.out.println("2. View Products");
            System.out.println("3. Sell Product");
            System.out.println("4. View Sales Report");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    System.out.print("Enter Product ID: ");
                    String id = sc.next();
                    System.out.print("Enter Product Name: ");
                    String name = sc.next();
                    System.out.print("Enter Quantity: ");
                    int qty = sc.nextInt();
                    System.out.print("Enter Price: ");
                    double price = sc.nextDouble();
                    dash.addProduct(new Product(id, name, qty, price));
                    break;
                case 2:
                    dash.viewProducts();
                    break;
                case 3:
                    System.out.print("Enter Product ID to Sell: ");
                    String pid = sc.next();
                    System.out.print("Enter Quantity to Sell: ");
                    int q = sc.nextInt();
                    dash.sellProduct(pid, q);
                    break;
                case 4:
                    dash.viewSalesReport();
                    break;
                case 5:
                    System.out.println("Exiting... Thank you!");
                    break;
                default:
                    System.out.println("Invalid choice.");
            }
        } while (choice != 5);
        sc.close();
    }
}
